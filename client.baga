// ── Multi-key / scanning ─────────────────────────────────────────────────

fn drock_mget(db: DrokDB, keys: Vec<bytes>) -> DrokMulti !Net !IO {
    if vec_len(keys) == 0 {
        return DrokMulti { ok: 1, found: vec_new(), vals: vec_new(), err: "" }
    }
    let r = drock__call(db, drock__appended("MGET", keys))?
    return drock__multi_of(r)
}

fn drock_mset(db: DrokDB, keys: Vec<bytes>, vals: Vec<bytes>) -> DrokStatus !Net !IO {
    if vec_len(keys) == 0 || vec_len(keys) != vec_len(vals) {
        return drock_status_err("drockb: MSET needs equal, non-empty key/value lists")
    }
    let args: Vec<bytes> = vec_new()
    vec_push(args, bytes_of_str("MSET"))
    let mut i: i64 = 0
    while i < vec_len(keys) {
        vec_push(args, vec_get(keys, i))
        vec_push(args, vec_get(vals, i))
        i = i + 1
    }
    let r = drock__call(db, args)?
    return drock__status_of(r)
}

fn drock_keys(db: DrokDB) -> DrokList !Net !IO {
    let r = drock__call(db, drock__a1("KEYS"))?
    return drock__list_of(r)
}

fn drock_scan(db: DrokDB, cursor: i64, count: i64, match_pat: str) -> DrokScanPage !Net !IO {
    let args: Vec<bytes> = vec_new()
    vec_push(args, bytes_of_str("SCAN"))
    vec_push(args, bytes_of_str(int_to_str(cursor)))
    if match_pat != "" {
        vec_push(args, bytes_of_str("MATCH"))
        vec_push(args, bytes_of_str(match_pat))
    }
    if count > 0 {
        vec_push(args, bytes_of_str("COUNT"))
        vec_push(args, bytes_of_str(int_to_str(count)))
    }
    let r = drock__call(db, args)?
    if r.ok == 0 || r.typ == 2 {
        return DrokScanPage { ok: 0, cursor: 0, keys: vec_new(), err: drock_reply_err(r) }
    }
    if r.typ != 5 || r.n != 2 {
        return DrokScanPage {
            ok: 0, cursor: 0, keys: vec_new(),
            err: "drockb: unexpected SCAN reply"
        }
    }
    let i0 = drock__item(r, 0)
    let i1 = drock__item(r, 1)
    if i0.ok != 1 || i1.ok != 1 || i1.typ != 5 || i1.n < 0 {
        return DrokScanPage {
            ok: 0, cursor: 0, keys: vec_new(),
            err: "drockb: malformed SCAN reply"
        }
    }
    let mut next: i64 = 0
    if i0.typ == 4 && i0.n > 0 {
        next = parse_int(str_of_bytes(i0.data))
    }
    let keys: Vec<bytes> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(i1.items) {
        let it = drock__item(i1, i)
        if it.ok == 1 && it.typ == 4 && it.n >= 0 {
            vec_push(keys, it.data)
        }
        i = i + 1
    }
    return DrokScanPage { ok: 1, cursor: next, keys: keys, err: "" }
}
